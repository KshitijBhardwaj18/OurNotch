<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated Info.plist. Only what build settings can't express: the ournotch:// link
     the website's "Open OurNotch" button uses to activate the app. -->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.ournotch.activate</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ournotch</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
